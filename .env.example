DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=PASTE_APPLICATION_CLIENT_ID_HERE

# Optional: guild commands update instantly. Leave empty for global commands.
DISCORD_GUILD_ID=
DISCORD_GUILD_IDS=

# Optional: admin/report/mod/ticket messages will be copied to this channel.
ADMIN_CHANNEL_ID=
REPORT_CHANNEL_ID=
# Master log channel for the server-events log system (per-event overrides set in dashboard).
LOG_CHANNEL_ID=
CLEAN_GLOBAL_COMMANDS=true
TEMP_ROOM_TRIGGER_CHANNEL_ID=
TEMP_ROOM_CATEGORY_ID=1308371578119127062

# Ticket panel: bot posts a static panel (buttons → modal → private тикет-N channel) here.
# TICKET_CATEGORY_ID is the category the created ticket/complaint channels go into.
# The bot role needs the "Manage Channels" permission to create/delete these channels.
TICKET_PANEL_CHANNEL_ID=
TICKET_CATEGORY_ID=

# Admin-only web dashboard (view tickets/reports + send-as-bot). Tickets are
# created in Discord via /ticket, not on the site. Disabled by default.
# SECURITY: no auth. Keep WEB_HOST=127.0.0.1 (localhost only). If you expose it
# publicly (WEB_HOST=0.0.0.0), you MUST set DASHBOARD_TOKEN or anyone can post
# messages as your bot.
WEB_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8080
DASHBOARD_TOKEN=

# Optional tuning.
DATABASE_PATH=data/database.json
ACCENT_COLOR=0x7C3AED
START_BALANCE=500
TIMELY_REWARD=250
TIMELY_SNOWBALLS=4
TIMELY_COOLDOWN_HOURS=12
PERSONAL_ROLE_PRICE=5000

# Progression (XP/levels). Messages grant XP with an anti-spam cooldown; voice grants per minute.
XP_MESSAGE_MIN=15
XP_MESSAGE_MAX=25
XP_MESSAGE_COOLDOWN_MS=60000
XP_VOICE_PER_MINUTE=8
# Auto-roles per level: "level:roleId" pairs, e.g. 5:1112223334445556,10:2223334445556667
LEVEL_ROLES=
# Channel for level-up notifications (empty = post in the channel where the level was reached).
LEVEL_UP_CHANNEL_ID=

# Mystery box drops. DROP_CHANNEL_ID empty = only manual /drop. Interval in ms.
DROP_CHANNEL_ID=
DROP_INTERVAL_MS=1800000

# Seasons. Results channel (empty = ADMIN_CHANNEL_ID) and a role awarded to the #1 player.
SEASON_CHANNEL_ID=
SEASON_WINNER_ROLE_ID=

# Twitch stream notifications. Empty client id/secret disables the feature.
# Create an app at https://dev.twitch.tv/console/apps to get these.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_MS=180000

# Auto-moderation defaults (per-guild overrides via dashboard / /automod).
# REQUIRES privileged intents enabled in the Dev Portal: Message Content + Server Members.
AUTOMOD_ENABLED=true
AUTOMOD_SPAM_COUNT=10
AUTOMOD_SPAM_WINDOW_MS=60000
AUTOMOD_MENTION_LIMIT=5
AUTOMOD_MENTION_RATE=8
AUTOMOD_MENTION_RATE_MS=30000
AUTOMOD_BLOCK_INVITES=true
AUTOMOD_BLOCK_LINKS=false
AUTOMOD_LINK_WHITELIST=google.,youtube.,youtu.be
AUTOMOD_CAPS=true
AUTOMOD_EMOJI_LIMIT=10
AUTOMOD_NEWLINE_LIMIT=8
AUTOMOD_BADWORDS=
AUTOMOD_BYPASS_ROLE_IDS=
AUTOMOD_STRIKE_WINDOW_MS=600000
